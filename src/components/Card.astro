---
import { Picture } from "astro:assets";
import type { BlogEntry } from "../libs/posts";
import type { Lang } from "../libs/site";

interface Props {
  href: string;
  title: string;
  image?: BlogEntry["data"]["image"];
  date?: Date;
  lang: Lang;
}

const { href, title, image, date, lang } = Astro.props;
const isExternal = href.startsWith("http");
const host = isExternal ? new URL(href).hostname : undefined;
const locale = lang === "ja" ? "ja-JP" : "en-US";
---

<a
  href={href}
  target={isExternal ? "_blank" : undefined}
  rel={isExternal ? "noopener noreferrer" : undefined}
  class="
    group
    relative
    flex
    aspect-4/3
    flex-col
    justify-end
    overflow-hidden
    rounded
    border-2
    border-line
    bg-placeholder
    transition-colors
    hover:border-accent
    dark:border-line-dark
    dark:bg-placeholder-dark
    dark:hover:border-accent-dark
  "
>
  {
    image && (
      <Picture
        src={image}
        formats={["avif", "webp"]}
        width={800}
        height={600}
        fit="cover"
        alt=""
        loading="lazy"
        pictureAttributes={{ class: "absolute inset-0 h-full w-full" }}
        class="h-full w-full object-cover transition-transform group-hover:scale-105"
      />
    )
  }
  <div
    class="
      absolute
      inset-0
      bg-[image:linear-gradient(to_bottom,transparent,rgb(0_0_0/0.65))]
      transition-opacity
      group-hover:opacity-90
    "
  >
  </div>
  <div class="relative flex flex-col gap-2 p-4">
    <h3
      class="line-clamp-2 text-base leading-[1.2] font-bold text-on-media"
    >
      {title}
    </h3>
    <div class="flex items-center justify-between gap-2">
      {
        date && (
          <time
            datetime={date.toISOString()}
            class="text-sm leading-[1.2] text-on-media/85"
          >
            {date.toLocaleDateString(locale, {
              year: "numeric",
              month: "long",
              day: "numeric",
            })}
          </time>
        )
      }
      {
        host && (
          <span class="ml-auto truncate text-xs leading-[1.2] text-on-media/75">
            {host}
          </span>
        )
      }
    </div>
  </div>
</a>
