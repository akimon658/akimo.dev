---
import { siteText, type Lang } from "../libs/site";

interface Props {
  lang: Lang;
  currentPath: string;
}

const { lang, currentPath } = Astro.props;
const { nav_home, nav_articles } = siteText[lang];

const basePath = lang === "ja" ? "/" : `/${lang}/`;
const articlesPath = `${basePath}blog/`;
const navItems = [
  { active: currentPath === basePath, href: basePath, label: nav_home },
  {
    active: currentPath === articlesPath,
    href: articlesPath,
    label: nav_articles,
  },
];
---

<header class="w-full">
  <div
    class="
      mx-auto
      flex
      h-16
      w-full
      max-w-[1440px]
      items-center
      justify-between
      px-6
      md:px-20
    "
  >
    <a
      href={basePath}
      class="
        text-xl
        leading-[1.2]
        font-bold
        text-body
        dark:text-body-dark
      "
    >
      akimo.dev
    </a>
    <nav class="flex items-center gap-2">
      {
        navItems.map((item) => (
          <a
            href={item.href}
            class:list={[
              "rounded px-4 py-2 text-base leading-[1.2] transition-colors",
              item.active
                ? "bg-subtle dark:bg-subtle-dark"
                : "hover:bg-subtle dark:hover:bg-subtle-dark",
            ]}
          >
            {item.label}
          </a>
        ))
      }
    </nav>
  </div>
</header>
